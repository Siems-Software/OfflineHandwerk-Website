---
import '../styles.css';
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import { languages, site } from '../config.mjs';
import { isLocale, otherLocale, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  route?: string;
  title: string;
  description?: string;
  variant?: 'page' | 'redirect';
  redirectHash?: string;
}

const { locale, route = '', title, description, variant = 'page', redirectHash } = Astro.props;
const path = route || undefined;
const other = otherLocale(locale);
const t = useTranslations(locale);
const home = getRelativeLocaleUrl(locale);
const asset = (name: string) => `${import.meta.env.BASE_URL}assets/${name}`;
const canonical = getAbsoluteLocaleUrl(locale, variant === 'redirect' ? 'privacy' : path);
const redirectTarget =
  variant === 'redirect' ? `${getRelativeLocaleUrl(locale, 'privacy')}#${redirectHash}` : '';
const languageHref =
  variant === 'redirect'
    ? `${getRelativeLocaleUrl(other, 'privacy')}#${redirectHash}`
    : getRelativeLocaleUrl(other, path);
const localeCodes = languages.filter(isLocale);
const csp =
  "default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {variant === 'page' && <meta name="description" content={description} />}
    {variant === 'page' && <meta name="color-scheme" content="dark" />}
    {variant === 'redirect' && (
      <>
        <meta name="robots" content="noindex" />
        <meta http-equiv="refresh" content={`0; url=${redirectTarget}`} />
      </>
    )}
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {variant === 'page' &&
      localeCodes.map((code) => (
        <link rel="alternate" hreflang={code} href={getAbsoluteLocaleUrl(code, path)} />
      ))}
    {variant === 'page' && (
      <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('de', path)} />
    )}
    <link rel="icon" href={asset('app-icon.png')} type="image/png" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    <header class="header">
      <div class="container header-inner">
        <a class="brand" href={home}>
          {variant === 'page' && <img src={asset('app-icon.png')} alt="" width="40" height="40" />}
          {site.name}
        </a>
        {variant === 'page' && (
          <nav class="main-nav" aria-label={t.navLabel}>
            <a href={`${home}#concept`}>{t.navConcept}</a>
            <a href={`${home}#features`}>{t.navFeatures}</a>
            <a href={`${home}#plans`}>{t.navPlans}</a>
          </nav>
        )}
        <a
          class="language"
          href={languageHref}
          lang={other}
          hreflang={other}
          aria-label={variant === 'page' ? t.switchLabel : undefined}
        >
          {other.toUpperCase()} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <slot />
    <footer class="footer">
      <div class="container footer-grid">
        <div>
          <a class="brand" href={home}>
            {site.name}
          </a>
          <p>{t.footerClaim}</p>
          <p class="small">{t.footerResources}</p>
        </div>
        <nav aria-label={t.footerLegal}>
          <a href={getRelativeLocaleUrl(locale, 'privacy')}>{t.privacy}</a>
          <a href={getRelativeLocaleUrl(locale, 'imprint')}>{t.imprint}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
