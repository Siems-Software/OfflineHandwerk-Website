---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { slugFor } from '../config.mjs';
import product from '../content/product.json';
import { escapeHtml } from '../lib/html.mjs';
import Base from './Base.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const asset = (name: string) => `${import.meta.env.BASE_URL}assets/${name}`;
const plans = ['free', 'solo', 'business'] as const;
const planCopy = {
  free: { name: t.freeName, description: t.freeDescription },
  solo: { name: t.soloName, description: t.soloDescription },
  business: { name: t.businessName, description: t.businessDescription },
};
const permissionKeys = Object.keys(t.features).filter((key) => key.startsWith('can'));
const entitlement = (plan: (typeof plans)[number], key: string) =>
  product.entitlements[plan][key as keyof (typeof product.entitlements)[typeof plan]];
const privacyHref = getRelativeLocaleUrl(locale, slugFor(locale, 'privacy'));
---

<Base locale={locale} title={t.metaTitle} description={t.metaDescription}>
  <main id="main">
    <section class="hero container">
      <div class="hero-copy">
        <p class="eyebrow">{t.heroEyebrow}</p>
        <h1
          set:html={`${escapeHtml(t.heroTitle)}<br /><span>${escapeHtml(t.heroAccent)}</span><br />${escapeHtml(t.heroEnd)}`}
        />
        <p class="lead">{t.heroBody}</p>
        <div class="actions">
          <a class="button" href="#features">
            {t.heroPrimary} <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="#concept">
            {t.heroSecondary} <span aria-hidden="true">↓</span>
          </a>
        </div>
        <p class="hero-note small">{t.heroNote}</p>
      </div>
      <figure class="product-shot">
        <img
          src={asset('app-home.webp')}
          alt={t.screenshotAlt}
          width="450"
          height="700"
          fetchpriority="high"
        />
        <figcaption>
          {t.screenshotCaption}
          <br />
          <a href={asset('app-home.webp')} aria-label={`${t.screenshotOpen}: ${t.screenshotAlt}`}>
            {t.screenshotOpen}
          </a>
        </figcaption>
      </figure>
    </section>
    <section id="concept" class="section section-surface">
      <div class="container">
        <p class="eyebrow">{t.conceptEyebrow}</p>
        <div class="section-heading">
          <h2>{t.conceptTitle}</h2>
          <p class="lead">{t.conceptBody}</p>
        </div>
        <div class="concept-grid">
          {t.conceptItems.map((item, index) => (
            <article>
              <span class="number" aria-hidden="true">
                0{index + 1}
              </span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
        <aside class="privacy-note">
          <p>{t.conceptCaveat}</p>
          <a href={privacyHref}>
            {t.conceptPrivacy} <span aria-hidden="true">↗</span>
          </a>
        </aside>
      </div>
    </section>
    <section id="features" class="section container">
      <p class="eyebrow">{t.featuresEyebrow}</p>
      <h2>{t.featuresTitle}</h2>
      <div class="workflow-layout">
        <ol class="workflow">
          {t.featureSteps.map((item, index) => (
            <li>
              <span class="step-number" aria-hidden="true">
                0{index + 1}
              </span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <figure class="product-shot">
          <img
            src={asset('app-calculations.webp')}
            alt={t.screenshotSecondAlt}
            width="450"
            height="700"
            loading="lazy"
          />
          <figcaption>
            {t.screenshotSecondCaption}
            <br />
            <a
              href={asset('app-calculations.webp')}
              aria-label={`${t.screenshotOpen}: ${t.screenshotSecondAlt}`}
            >
              {t.screenshotOpen}
            </a>
          </figcaption>
        </figure>
      </div>
    </section>
    <section id="plans" class="section section-surface">
      <div class="container">
        <p class="eyebrow">{t.plansEyebrow}</p>
        <h2>{t.plansTitle}</h2>
        <p class="lead plan-intro">{t.plansBody}</p>
        <div class="plan-grid">
          {plans.map((plan) => (
            <article class="plan-card">
              <h3>{planCopy[plan].name}</h3>
              <p>{planCopy[plan].description}</p>
              {plan === 'free' ? (
                <p class="price-free">{t.freePrice}</p>
              ) : (
                <dl class="prices">
                  <div>
                    <dt>{t.monthly}</dt>
                    <dd>{t.pricePending}</dd>
                  </div>
                  <div>
                    <dt>{t.yearly}</dt>
                    <dd>{t.pricePending}</dd>
                  </div>
                </dl>
              )}
            </article>
          ))}
        </div>
        <p class="small pricing-note">{t.pricingNote}</p>
        <div class="table-wrap">
          <table>
            <caption>{t.tableCaption}</caption>
            <thead>
              <tr>
                <th scope="col">{t.tableFeature}</th>
                {plans.map((plan) => (
                  <th scope="col">{planCopy[plan].name}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {Object.entries(product.limits).map(([key, count]) => (
                <tr data-feature={key}>
                  <th scope="row">{t.features[key as keyof typeof t.features]}</th>
                  <td>{t.limited.replace('{count}', String(count))}</td>
                  <td>
                    <span class="limit-icon" aria-hidden="true">
                      ∞
                    </span>
                    <span class="sr-only">{t.unlimited}</span>
                  </td>
                  <td>
                    <span class="limit-icon" aria-hidden="true">
                      ∞
                    </span>
                    <span class="sr-only">{t.unlimited}</span>
                  </td>
                </tr>
              ))}
              {permissionKeys.map((key) => (
                <tr data-feature={key}>
                  <th scope="row">{t.features[key as keyof typeof t.features]}</th>
                  {plans.map((plan) => {
                    const included = entitlement(plan, key);
                    return (
                      <td>
                        <span class={included ? 'yes' : 'no'}>
                          <span aria-hidden="true">{included ? '✓' : '—'}</span>
                          <span class="sr-only">{included ? t.included : t.notIncluded}</span>
                        </span>
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="small table-legend">
          <span aria-hidden="true">∞ = </span>
          {t.unlimited}
        </p>
        <p class="small">{t.backupNote}</p>
      </div>
    </section>
    <section id="download" class="section container download">
      <p class="eyebrow">{t.downloadEyebrow}</p>
      <h2>{t.downloadTitle}</h2>
      <p class="lead">{t.downloadBody}</p>
      <div class="store-grid">
        <div class="store-placeholder" aria-disabled="true">
          <span class="store-icon" aria-hidden="true">
            ▶
          </span>
          <div>
            <strong>{t.googlePlay}</strong>
            <span>{t.storePending}</span>
          </div>
        </div>
        <div class="store-placeholder" aria-disabled="true">
          <span class="store-icon" aria-hidden="true">
            ↗
          </span>
          <div>
            <strong>{t.appStore}</strong>
            <span>{t.storePending}</span>
          </div>
        </div>
      </div>
      <p class="small">{t.downloadNote}</p>
    </section>
  </main>
</Base>
