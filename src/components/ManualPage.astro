---
import { site } from '../config.mjs';
import { useTranslations, type Locale } from '../i18n';
import Base from './Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Base
  locale={locale}
  route="manual"
  title={`${t.manualTitle} | ${site.name}`}
  description={t.manualLead}
>
  <main id="main" class="container manual">
    <h1>{t.manualTitle}</h1>
    <p class="lead">{t.manualLead}</p>
    {t.manualSections.map((section) => (
      <section>
        <h2>{section.title}</h2>
        <ol>
          {section.steps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </section>
    ))}
  </main>
</Base>
