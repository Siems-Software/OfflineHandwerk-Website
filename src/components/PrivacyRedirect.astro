---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { site } from '../config.mjs';
import { useTranslations, type Locale } from '../i18n';
import Base from './Base.astro';

interface Props {
  locale: Locale;
  hash: 'app' | 'website';
}

const { locale, hash } = Astro.props;
const t = useTranslations(locale);
const target = `${getRelativeLocaleUrl(locale, 'privacy')}#${hash}`;
---

<Base locale={locale} variant="redirect" redirectHash={hash} title={`${t.privacy} | ${site.name}`}>
  <main id="main" class="container legal-page">
    <p>
      <a href={target}>{t.privacy}</a>
    </p>
  </main>
</Base>
